// Prisma schema for Permit to Work (PTW) CMMS System
// Single Table Inheritance with PostgreSQL JSONB dynamic extension

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  AREA_OWNER
  SAFETY_OFFICER
  ADMIN
}

enum PermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  EXPIRED
  REJECTED
  CLOSED
  CLOSED_VERIFIED
  CANCELLED
}

enum PermitType {
  HOT_WORK
  CONFINED_SPACE
  WORKING_AT_HEIGHT
  ELECTRICAL_LOTO
  EXCAVATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  areaId       String?
  area         Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)

  requestedPermits Permit[]         @relation("PermitRequester")
  approvals        PermitApproval[] @relation("ApproverUser")
  auditLogs        PermitAuditLog[] @relation("AuditUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([areaId])
}

model Plant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  areas     Area[]
  permits   Permit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id        String      @id @default(uuid())
  name      String
  plantId   String
  plant     Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  equipment Equipment[]
  users     User[]
  permits   Permit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId])
}

model Equipment {
  id           String   @id @default(uuid())
  name         String
  equipmentTag String   @unique
  areaId       String
  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  permits      Permit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId])
}

model Permit {
  id              String       @id @default(uuid())
  permitNumber    String       @unique
  type            PermitType
  status          PermitStatus @default(DRAFT)
  requesterId     String
  requester       User         @relation("PermitRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  contractorTeam  String
  workDescription String       @db.Text
  plantId         String
  plant           Plant        @relation(fields: [plantId], references: [id], onDelete: Restrict)
  areaId          String
  area            Area         @relation(fields: [areaId], references: [id], onDelete: Restrict)
  equipmentId     String?
  equipment       Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  plannedStart DateTime
  plannedEnd   DateTime

  hazards     Json
  ppeRequired Json
  precautions Json

  typeSpecificData Json?

  approvals PermitApproval[]
  auditLogs PermitAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([areaId])
  @@index([plantId])
  @@index([plannedStart])
  @@index([plannedEnd])
  @@index([requesterId])
  @@index([status, type])
}

model PermitApproval {
  id              String         @id @default(uuid())
  permitId        String
  permit          Permit         @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approverId      String
  approver        User           @relation("ApproverUser", fields: [approverId], references: [id], onDelete: Restrict)
  role            UserRole
  status          ApprovalStatus @default(PENDING)
  comment         String?        @db.Text
  approvedAt      DateTime?
  rejectionReason String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([permitId])
  @@index([approverId])
}

model PermitAuditLog {
  id        String   @id @default(uuid())
  permitId  String
  permit    Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  whoId     String
  who       User     @relation("AuditUser", fields: [whoId], references: [id], onDelete: Restrict)
  action    String
  timestamp DateTime @default(now())
  fromValue String?
  toValue   String?
  comment   String?  @db.Text

  @@index([permitId])
  @@index([whoId])
  @@index([timestamp])
}
